// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Admin users who can access the admin panel
model Admin {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  password  String    // Hashed with bcrypt
  role      AdminRole @default(ADMIN)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("admins")
}

// Patients who book appointments
model Patient {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  phone        String
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([email])
  @@map("patients")
}

// Appointments booked by patients
model Appointment {
  id                 String            @id @default(cuid())
  confirmationNumber String            @unique
  serviceId          String
  serviceName        String
  date               DateTime
  timeSlot           String
  patient            Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId          String
  notes              String?           @db.Text
  status             AppointmentStatus @default(PENDING)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([patientId])
  @@index([date])
  @@index([status])
  @@index([confirmationNumber])
  @@map("appointments")
}

// Appointment status enum
enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

// Admin role enum for future role-based access control
enum AdminRole {
  SUPER_ADMIN
  ADMIN
  VIEWER
}


// Audit logging for security and tracking
model AuditLog {
  id        String   @id @default(cuid())
  adminId   String
  adminName String
  action    String
  details   String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@map("audit_logs")
}
